# PostgreSQL connection. Use a URL-encoded password if it contains reserved URL characters.
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require
DATABASE_URL_DOCKER=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@db:5432/postgres
POSTGRES_DB=siberlens_local
POSTGRES_USER=YOUR_USER
POSTGRES_PASSWORD=YOUR_PASSWORD

# Comma-separated exact browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional frontend API base URL (Vite environment variables must use the VITE_ prefix).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public Supabase Auth configuration. Never use a service-role key in the frontend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Scheduled RSS synchronization. Generate a random secret of at least 32 characters.
# Keep it server-side; never add RSS_SYNC_SECRET to VITE_ variables.
RSS_SYNC_SECRET=
RSS_SYNC_SCHEDULE_ENABLED=false
